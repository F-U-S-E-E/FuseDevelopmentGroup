# Generated by Unity on open / first import — large, machine-specific, never committed.
Library/
Temp/
Obj/
obj/
Build/
Builds/
Logs/
UserSettings/

# Auto-generated solution / project files Unity emits for IDE integration.
*.csproj
*.sln
*.suo
*.user

# DLLs copied in by prepare_assets.ps1 — not committed because they're either
# build outputs (FUSE.dll) or game install artifacts (Assembly-CSharp.dll, etc.)
# whose contents we shouldn't be redistributing or pinning.
Assets/Plugins/*.dll
Assets/Plugins/*.dll.meta
Assets/Plugins/*.pdb

# Test results land here when run via the CLI; CI uploads them but we don't
# want them in the working tree.
TestResults/
test-results.xml
