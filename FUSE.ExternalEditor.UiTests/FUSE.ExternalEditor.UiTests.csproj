<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 (pulled in by Avalonia.Headless.XUnit) runs tests via an
         app-host executable, so the test project must emit an exe. -->
    <OutputType>Exe</OutputType>
    <AssemblyName>FUSE.ExternalEditor.UiTests</AssemblyName>
    <RootNamespace>Fuse.ExternalEditor.UiTests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Headless UI tests: no game/Unity DLLs, builds with no GameDir. -->
    <FuseIsGameFree>true</FuseIsGameFree>
    <!-- xUnit test methods are instance by convention. -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FUSE.ExternalEditor\FUSE.ExternalEditor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\schemas\fuse-mod.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Golden terrain values dumped from the Python reference (edit_tiles/terrain.py). -->
    <None Include="Fixtures\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
