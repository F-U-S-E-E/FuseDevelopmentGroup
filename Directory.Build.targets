<Project>
  <!-- Mod-version stamping applies only to in-game (net48) mod assemblies.
       Game-free projects (FUSE.Core, FUSE.Core.Tests, FUSE.ExternalEditor,
       FUSE.ExternalEditor.UiTests) set FuseIsGameFree=true and keep their own
       <Version>, so they are excluded here. -->
  <PropertyGroup Condition="'$(FuseIsGameFree)' != 'true'">
    <ModVersionCore>$([System.Text.RegularExpressions.Regex]::Match('$(ModVersion)', '^[0-9]+\.[0-9]+\.[0-9]+').Value)</ModVersionCore>
    <ModVersionCore Condition="'$(ModVersionCore)' == ''">0.0.0</ModVersionCore>
    <Version>$(ModVersion)</Version>
    <AssemblyVersion>$(ModVersionCore).0</AssemblyVersion>
    <FileVersion>$(ModVersionCore).0</FileVersion>
    <ProductVersion>$(ModVersion)</ProductVersion>
    <InformationalVersion>$(ModVersion)</InformationalVersion>
  </PropertyGroup>

  <!--
    Stamp the build-deployed Info.json with the real ModVersion.

    The version is supplied by the release flow and nowhere else. The source
    FUSE/Info.json is pinned at 0.0.0 on purpose: a build without
    -p:ModVersion=... skips stamping and mirrors source, so 0.0.0 in Unity Mod
    Manager is the deliberate signal "this is a local/debug build, not a
    release". Do not bump the source manifest to track the latest release, and
    do not add a git-describe style fallback — either would make a dev build
    indistinguishable from a shipped one in UMM.

    release.yml passes -p:ModVersion=<semver from tag>, so published artifacts
    always carry the real version. scripts/Validate-ModPackage.cs fails the
    release if a packaged Info.json still reads 0.0.0, which is what stops an
    unstamped build from ever shipping.
  -->
  <Target Name="InjectModVersionIntoInfoJson" AfterTargets="AfterBuild" Condition="'$(ModVersion)' != '0.0.0' AND Exists('$(TargetDir)Info.json') and '$(FuseIsGameFree)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\stamp-info-version.ps1&quot; -Path &quot;$(TargetDir)Info.json&quot; -Version $(ModVersionCore)" />
  </Target>
</Project>
