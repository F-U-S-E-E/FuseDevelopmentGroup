{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunterr.dev/rail/schemas/umm-info.schema.json",
  "title": "RAIL Unity Mod Manager Info.json",
  "description": "UMM manifest shape for the RAIL API mod and RAIL data packages.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "Id",
    "DisplayName",
    "Author",
    "Version",
    "ManagerVersion"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "Id": {
      "$ref": "#/$defs/id"
    },
    "DisplayName": {
      "type": "string",
      "minLength": 1
    },
    "Author": {
      "type": "string",
      "minLength": 1
    },
    "Version": {
      "type": "string",
      "minLength": 1
    },
    "ManagerVersion": {
      "type": "string",
      "minLength": 1
    },
    "GameVersion": {
      "type": "string"
    },
    "AssemblyName": {
      "type": "string",
      "description": "Required for code mods like RAIL. Omit for RAIL data-only packages if UMM accepts the folder."
    },
    "EntryMethod": {
      "type": "string",
      "description": "Required when AssemblyName is present."
    },
    "HomePage": {
      "type": "string"
    },
    "Repository": {
      "type": "string"
    },
    "Requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "default": []
    },
    "LoadAfter": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "default": []
    },
    "RailLoadPriority": {
      "type": "integer",
      "default": 0,
      "description": "RAIL-specific package ordering priority. Lower values load earlier; ties fall back to dependency order, then package id."
    },
    "RailLoadAfter": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "default": [],
      "description": "RAIL-specific data package ids that must load before this package."
    },
    "RailLoadBefore": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "default": [],
      "description": "RAIL-specific data package ids that must load after this package."
    },
    "RailDataFile": {
      "type": "string",
      "pattern": "^.+\\.(bson|json)$",
      "description": "RAIL-specific pointer to one mod definition file in this UMM folder."
    },
    "RailDataFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^.+\\.(bson|json)$"
      },
      "default": [],
      "description": "RAIL-specific ordered list of definition fragments to load from this UMM folder."
    },
    "RailAssetPacks": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      ],
      "description": "RAIL-specific relative folder or folders containing Railroader AssetPack Runtime stores, for example SCAssetPacks."
    },
    "Settings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "EnableExperimentalEarlyScenePathSuppression": {
          "type": "boolean",
          "default": false,
          "description": "Experimental. Gates Unity async scene activation so world.suppressBaseScenePaths can be applied as early as Unity exposes scene objects. Disabled by default because a failed gate can wedge scene loading."
        }
      }
    }
  },
  "dependentRequired": {
    "AssemblyName": [
      "EntryMethod"
    ],
    "EntryMethod": [
      "AssemblyName"
    ]
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "dependency": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "Id"
          ],
          "properties": {
            "Id": {
              "$ref": "#/$defs/id"
            },
            "NotBefore": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
