{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunterr.dev/rail/schemas/rail-mod.schema.json",
  "title": "RAIL Mod Definition",
  "description": "Human-readable JSON form of a RAIL map mod. BSON uses the same logical model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "author"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "oneOf": [
        {
          "type": "string",
          "const": "1.0"
        },
        {
          "type": "integer",
          "const": 1,
          "deprecated": true
        }
      ],
      "default": "1.0",
      "description": "RAIL data schema version. This drives migrations and is separate from modVersion. Use the string form, for example \"1.0\"; integer 1 remains accepted for v1.0 compatibility."
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "modVersion": {
      "type": "string",
      "default": "1.0.0"
    },
    "railroaderVersion": {
      "type": "string",
      "description": "Minimum supported Railroader version."
    },
    "description": {
      "type": "string"
    },
    "coordinateSpace": {
      "type": "string",
      "enum": [
        "world"
      ],
      "default": "world"
    },
    "tracks": {
      "$ref": "#/$defs/tracks"
    },
    "operations": {
      "$ref": "#/$defs/operations"
    },
    "world": {
      "$ref": "#/$defs/world"
    },
    "progression": {
      "$ref": "#/$defs/progression"
    },
    "editor": {
      "$ref": "#/$defs/editor"
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension data. Use reverse-DNS keys, for example com.example.tool.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "idRef": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(vanilla|path|scenery|asset|rail|file|empty)://.*$"
    },
    "vec3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "dictionary": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      }
    },
    "tracks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/trackNode"
              }
            }
          ],
          "default": {}
        },
        "segments": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/trackSegment"
              }
            }
          ],
          "default": {}
        },
        "spans": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/trackSpan"
              }
            }
          ],
          "default": {}
        },
        "areas": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/trackArea"
              }
            }
          ],
          "default": {}
        },
        "removals": {
          "$ref": "#/$defs/trackRemovals",
          "default": {
            "nodes": [],
            "segments": [],
            "spans": []
          }
        }
      }
    },
    "trackRemovals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "$ref": "#/$defs/idArray"
        },
        "segments": {
          "$ref": "#/$defs/idArray"
        },
        "spans": {
          "$ref": "#/$defs/idArray"
        }
      }
    },
    "trackNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/vec3",
          "default": {
            "x": 0,
            "y": 0,
            "z": 0
          }
        },
        "flipSwitchStand": {
          "type": "boolean",
          "default": false
        },
        "groupId": {
          "$ref": "#/$defs/idRef"
        },
        "tags": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "trackSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startNodeId",
        "endNodeId"
      ],
      "properties": {
        "startNodeId": {
          "$ref": "#/$defs/idRef"
        },
        "endNodeId": {
          "$ref": "#/$defs/idRef"
        },
        "style": {
          "type": "string",
          "default": "standard"
        },
        "trackClass": {
          "type": "string",
          "default": "main"
        },
        "speedLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 80,
          "default": 45
        },
        "priority": {
          "type": "integer",
          "default": 0
        },
        "groupId": {
          "$ref": "#/$defs/idRef"
        },
        "tags": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "trackLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId"
      ],
      "oneOf": [
        {
          "required": [
            "normalized"
          ]
        },
        {
          "required": [
            "distance"
          ]
        }
      ],
      "properties": {
        "segmentId": {
          "$ref": "#/$defs/idRef"
        },
        "normalized": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "distance": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "Start",
            "End"
          ],
          "description": "Which segment end the normalized or distance value is measured from. Omit for the default A/start orientation."
        },
        "offset": {
          "type": "number",
          "default": 0
        }
      }
    },
    "trackSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upper",
        "lower"
      ],
      "properties": {
        "upper": {
          "$ref": "#/$defs/trackLocation"
        },
        "lower": {
          "$ref": "#/$defs/trackLocation"
        },
        "normalize": {
          "type": "boolean",
          "default": true
        },
        "groupId": {
          "$ref": "#/$defs/idRef"
        }
      }
    },
    "trackArea": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "tagColor": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "spanIds": {
          "$ref": "#/$defs/idArray"
        },
        "groupId": {
          "$ref": "#/$defs/idRef"
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loads": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/load"
              }
            }
          ],
          "default": {}
        },
        "industries": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/industry"
              }
            }
          ],
          "default": {}
        },
        "loaders": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/loader"
              }
            }
          ],
          "default": {}
        },
        "turntables": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/turntable"
              }
            }
          ],
          "default": {}
        },
        "stations": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/station"
              }
            }
          ],
          "default": {}
        }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": "string",
          "enum": [
            "Pounds",
            "Gallons",
            "Quantity"
          ],
          "default": "Pounds"
        },
        "density": {
          "type": "number",
          "minimum": 0,
          "default": 62.4
        },
        "unitWeightInPounds": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "importable": {
          "type": "boolean",
          "default": true
        },
        "payPerQuantity": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "costPerUnit": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "carTypeFilter": {
          "type": "string"
        },
        "emptyCarType": {
          "type": "string"
        },
        "loadedCarType": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/uri"
        }
      }
    },
    "industry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "position"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "areaId": {
          "$ref": "#/$defs/idRef"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/vec3",
          "default": {
            "x": 0,
            "y": 0,
            "z": 0
          }
        },
        "usesContract": {
          "type": "boolean",
          "default": false
        },
        "components": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/industryComponent"
              }
            }
          ],
          "default": {}
        }
      }
    },
    "industryComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "loader",
            "unloader",
            "storage",
            "formulaic",
            "repairTrack",
            "repair-track",
            "teamTrack",
            "team-track",
            "interchange",
            "interchangedLoader",
            "interchanged-loader",
            "passengerStop",
            "passenger-stop",
            "custom"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "trackSpanIds": {
          "$ref": "#/$defs/idArray"
        },
        "carTypeFilter": {
          "type": "string"
        },
        "loadId": {
          "$ref": "#/$defs/idRef"
        },
        "sharedStorage": {
          "type": "boolean",
          "default": true
        },
        "storageChangeRate": {
          "type": "number"
        },
        "maxStorage": {
          "type": "number",
          "minimum": 0
        },
        "carTransferRate": {
          "type": "number",
          "minimum": 0
        },
        "orderAroundEmpties": {
          "type": "boolean"
        },
        "orderAroundLoaded": {
          "type": "boolean"
        },
        "inputSpanIds": {
          "$ref": "#/$defs/idArray"
        },
        "inputTermsPerDay": {
          "$ref": "#/$defs/loadRateMap"
        },
        "outputTermsPerDay": {
          "$ref": "#/$defs/loadRateMap"
        },
        "idealCars": {
          "type": "number",
          "minimum": 0
        },
        "teamProfiles": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/teamTrackEntry"
          },
          "default": {}
        },
        "canOverhaul": {
          "type": "boolean"
        },
        "passengerStopId": {
          "$ref": "#/$defs/idRef"
        },
        "timetableCode": {
          "type": "string"
        },
        "basePopulation": {
          "type": "integer",
          "minimum": 0
        },
        "neighborIds": {
          "$ref": "#/$defs/idArray"
        },
        "branch": {
          "type": "string"
        },
        "branchDefinitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/passengerBranch"
          },
          "default": []
        }
      }
    },
    "loadRateMap": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "default": {}
    },
    "teamTrackEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loadId"
      ],
      "properties": {
        "isExport": {
          "type": "boolean",
          "default": false
        },
        "loadId": {
          "$ref": "#/$defs/idRef"
        },
        "loadingTimeDays": {
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "carTypeFilter": {
          "type": "string"
        }
      }
    },
    "passengerBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch"
      ],
      "properties": {
        "branch": {
          "type": "string"
        },
        "traverseTimeToNext": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "mapFeature": {
          "$ref": "#/$defs/idRef"
        },
        "intermediates": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/passengerIntermediate"
          },
          "default": {}
        }
      }
    },
    "passengerIntermediate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "traverseTimeToNext": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "loader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "prefab"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/vec3",
          "default": {
            "x": 0,
            "y": 0,
            "z": 0
          }
        },
        "prefab": {
          "$ref": "#/$defs/uri"
        },
        "industryId": {
          "$ref": "#/$defs/idRef"
        }
      }
    },
    "turntable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "radius"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/vec3",
          "default": {
            "x": 0,
            "y": 0,
            "z": 0
          }
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "subdivisions": {
          "type": "integer",
          "minimum": 4,
          "maximum": 32,
          "default": 16
        },
        "legacyIdentifier": {
          "type": "string",
          "description": "Optional legacy turntable identifier used to reproduce existing helper node and roundhouse segment IDs."
        },
        "roundhouse": {
          "$ref": "#/$defs/roundhouse"
        }
      }
    },
    "roundhouse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stalls"
      ],
      "properties": {
        "stalls": {
          "type": "integer",
          "minimum": 1
        },
        "startAngle": {
          "type": "number",
          "default": 0
        },
        "stallAngle": {
          "type": "number"
        },
        "trackLength": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 46
        },
        "startPrefab": {
          "$ref": "#/$defs/uri"
        },
        "endPrefab": {
          "$ref": "#/$defs/uri"
        },
        "stallPrefab": {
          "$ref": "#/$defs/uri"
        }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "prefab"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/vec3",
          "default": {
            "x": 0,
            "y": 0,
            "z": 0
          }
        },
        "prefab": {
          "$ref": "#/$defs/uri"
        },
        "passengerStopId": {
          "$ref": "#/$defs/idRef"
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenery": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/scenery"
              }
            }
          ],
          "default": {}
        },
        "splineys": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/spliney"
              }
            }
          ],
          "default": {}
        },
        "telegraphPoles": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/telegraphPoles"
              }
            }
          ],
          "default": {}
        },
        "mapLabels": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/mapLabel"
              }
            }
          ],
          "default": {}
        },
        "mapMasks": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/mapMask"
              }
            }
          ],
          "default": {}
        },
        "mapTiles": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/mapTileSource"
              }
            }
          ],
          "default": {}
        },
        "sceneClones": {
          "allOf": [
            {
              "$ref": "#/$defs/dictionary"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/sceneClone"
              }
            }
          ],
          "default": {}
        },
        "suppressBaseScenePaths": {
          "$ref": "#/$defs/suppressionStringArray",
          "description": "Base-game scene paths to hide or disable when this package applies."
        },
        "suppressBaseTrackGroups": {
          "$ref": "#/$defs/suppressionStringArray",
          "description": "Base-game track group IDs to suppress when this package applies."
        },
        "suppressBaseAreas": {
          "$ref": "#/$defs/suppressionStringArray",
          "description": "Base-game area IDs to suppress when this package applies."
        },
        "suppressScenePaths": {
          "$ref": "#/$defs/suppressionStringArray",
          "description": "Deprecated alias for suppressBaseScenePaths. RAIL normalizes it on load."
        },
        "suppressGroups": {
          "$ref": "#/$defs/suppressionStringArray",
          "description": "Deprecated alias for suppressBaseTrackGroups. RAIL normalizes it on load."
        },
        "suppressAreas": {
          "$ref": "#/$defs/suppressionStringArray",
          "description": "Deprecated alias for suppressBaseAreas. RAIL normalizes it on load."
        },
        "removals": {
          "$ref": "#/$defs/worldRemovals",
          "default": {
            "scenery": [],
            "splineys": [],
            "telegraphPoles": [],
            "mapLabels": [],
            "mapMasks": [],
            "sceneClones": []
          }
        }
      }
    },
    "worldRemovals": {
      "type": "object",
      "additionalProperties": false,
      "description": "Scene-path or RAIL-id removals for world objects. Use this to carry source JSON null entries through conversion.",
      "properties": {
        "scenery": {
          "$ref": "#/$defs/worldRemovalArray"
        },
        "splineys": {
          "$ref": "#/$defs/worldRemovalArray"
        },
        "telegraphPoles": {
          "$ref": "#/$defs/worldRemovalArray"
        },
        "mapLabels": {
          "$ref": "#/$defs/worldRemovalArray"
        },
        "mapMasks": {
          "$ref": "#/$defs/worldRemovalArray"
        },
        "sceneClones": {
          "$ref": "#/$defs/worldRemovalArray"
        }
      }
    },
    "scenery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position"
      ],
      "anyOf": [
        {
          "required": [
            "assetIdentifier"
          ]
        },
        {
          "required": [
            "model"
          ]
        }
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "deprecated": true,
          "description": "Deprecated v1.0 compatibility field. If assetIdentifier is missing, RAIL treats model as the asset identifier and logs one deprecation warning per package."
        },
        "assetIdentifier": {
          "$ref": "#/$defs/uri"
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/vec3",
          "default": {
            "x": 0,
            "y": 0,
            "z": 0
          }
        },
        "scale": {
          "$ref": "#/$defs/vec3",
          "default": {
            "x": 1,
